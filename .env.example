# ── Foremark Environment Configuration ──────────────────────────────────
# Copy this file to `.env` and fill in the values you need.

# HTTP server port
PORT=3000

# Directory where the SQLite database and backups are persisted.
# In Docker this is mounted as a volume (see docker-compose.yml).
DATA_DIR=./data

# Default AI provider used when a request does not specify one.
# Supported: openai | anthropic | gemini | ollama
DEFAULT_AI_PROVIDER=openai

# ── Provider API keys (leave blank to disable a provider) ───────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Base URL for a local Ollama instance (no API key required).
OLLAMA_BASE_URL=http://localhost:11434

# ── Optional default models per provider ────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-flash-latest
OLLAMA_MODEL=llama3.1
